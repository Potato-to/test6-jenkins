VITE_API_BASE_URL=http://127.0.0.1:8081
# 业务接口公共前缀；无前缀时设为留空。上传路径不受影响。
VITE_API_PREFIX=/api
# 开发环境默认演示；设为 false 可在开发时联调。生产构建始终使用真实接口。
# VITE_DEMO_MODE=false
# 默认直接调用后端，后端需支持跨域。若按需启用开发代理，需取消 vite.config.ts 中的代理注释并清空 VITE_API_BASE_URL：
# DEV_API_UPSTREAM=http://127.0.0.1:8081
# 直连 API 域名时填写 VITE_API_BASE_URL，后端需支持跨域。
VITE_UPLOAD_URL=/files/upload
VITE_FRAME_HOSTS=
